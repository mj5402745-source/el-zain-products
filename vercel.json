{
  "version": 2,
  "builds": [
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/public/(.*)",
      "headers": {
        "Cache-Control": "public, max-age=31536000, immutable"
      },
      "dest": "/public/$1"
    },
    {
      "src": "/style.css",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      },
      "dest": "/style.css"
    },
    {
      "src": "/script.js",
      "headers": {
        "Cache-Control": "public, max-age=86400"
      },
      "dest": "/script.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}